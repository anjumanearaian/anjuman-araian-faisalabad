# Set these in Vercel Project Settings > Environment Variables, then redeploy.
# For local use only, copy to .env. Never commit real secrets.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
JWT_SECRET=replace-with-at-least-32-random-bytes
ADMIN_USERNAME=anjumanearaianfaisalabad@gmail.com
ADMIN_PASSWORD=replace-with-a-strong-password
MASTER_EMAIL=anjumanearaianfaisalabad@gmail.com
INFO_EMAIL=info@anjumanearaian.org
# Choose ONE mail configuration. Explicit SMTP takes priority over Gmail aliases.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=anjumanearaianfaisalabad@gmail.com
SMTP_PASSWORD=replace-with-google-app-password-without-spaces
EMAIL_FROM=anjumanearaianfaisalabad@gmail.com
# Alternative: remove ALL SMTP_* values and set GMAIL_USER and GMAIL_APP_PASSWORD.
# Google button is optional. Leave both empty until a real Web Client ID is ready.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
# Same-domain Vercel deployment uses /api. No Supabase public auth keys are used.
VITE_API_URL=/api
CRON_SECRET=replace-with-a-long-random-secret
ALLOWED_ORIGINS=https://anjumanearaian.org,https://www.anjumanearaian.org
BLOB_READ_WRITE_TOKEN=
