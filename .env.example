# Vercel / local environment template. Do NOT commit real secrets.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=anjumanearaianfaisalabad@gmail.com
ADMIN_PASSWORD=replace-with-a-strong-password
MASTER_EMAIL=anjumanearaianfaisalabad@gmail.com
INFO_EMAIL=info@anjumanearaian.org
# Gmail requires 2-Step Verification and an app password (never the normal account password).
GMAIL_USER=anjumanearaianfaisalabad@gmail.com
GMAIL_APP_PASSWORD=replace-with-google-app-password
# Create a Google OAuth 2.0 Web Client and use the same Client ID in both values.
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id.apps.googleusercontent.com
CRON_SECRET=replace-with-a-long-random-secret
ALLOWED_ORIGINS=https://anjumanearaian.org,https://www.anjumanearaian.org
# Added automatically when Vercel Blob is connected:
BLOB_READ_WRITE_TOKEN=
