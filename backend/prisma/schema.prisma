generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
}

model Message {
  id        String   @id @default(uuid())
  type      String   // "contact" or "forgot_password"
  name      String
  email     String
  phone     String?
  message   String
  status    String   @default("unread") // "unread" or "resolved"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model Member {
  id               String       @id @default(uuid())
  memberNo         String       @unique
  fullName         String
  fatherName       String
  cnic             String
  dob              String
  gender           String
  bloodGroup       String
  email            String
  phone            String
  whatsapp         String
  whatsappPublic   Boolean      @default(false)
  address          String
  city             String
  district         String
  province         String
  occupation       String
  education        String
  membershipType   String
  password         String
  familyInfoPublic Boolean      @default(false)
  status           String       @default("pending")
  visibility       String       @default("private")
  showOnWeb        Boolean      @default(false)
  showOnPortal     Boolean      @default(true)
  photoUrl         String?
  cnicFrontUrl     String?
  cnicBackUrl      String?
  paymentProofUrl  String?
  additionalPhotos String?      // Stored as JSON string
  adminNote        String?
  rejectionReason  String?
  isFeatured       Boolean      @default(false)
  isFeaturedPortal Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  approvedAt       DateTime?

  familyInfo       FamilyInfo?

  @@index([status])
  @@index([membershipType])
  @@index([createdAt])
}

model FamilyInfo {
  id                     String  @id @default(uuid())
  memberId               String  @unique
  member                 Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  fatherName             String?
  familyBranch           String?
  spouseName             String?
  childrenCount          String?
  childrenDetails        String?
  familyContactName      String?
  familyContactNumber    String?
  familyCity             String?
  emergencyContactName   String?
  emergencyContactNumber String?
  emergencyRelationship  String?
}

model Business {
  id                 String   @id @default(uuid())
  businessName       String
  ownerName          String
  category           String
  city               String
  address            String
  phone              String
  whatsapp           String
  email              String
  website            String
  socialLinks        String
  productsServices   String
  discountOffer      String
  description        String
  sponsorshipPackage String
  logoUrl            String?
  paymentProofUrl    String?
  additionalPhotos   String?  // Stored as JSON string
  status             String   @default("pending")
  paymentStatus      String   @default("pending")
  adminNote          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model Matrimonial {
  id               String   @id @default(uuid())
  name             String
  gender           String
  age              String
  city             String
  education        String
  profession       String
  familyBackground String
  requirements     String
  contact          String
  photoUrl         String?
  additionalPhotos String?  // JSON string
  paymentProofUrl  String?
  status           String   @default("pending")
  paymentStatus    String   @default("pending")
  adminNote        String?
  isFeatured       Boolean  @default(false)
  showOnPortal     Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])
  @@index([paymentStatus])
  @@index([isFeatured])
  @@index([createdAt])
}

model Content {
  id        String   @id @default(uuid())
  type      String   // "news" or "event"
  title     String
  body      String
  date      String
  time      String?
  location  String?
  category  String
  status    String   @default("draft")
  images    String?  // JSON string
  createdAt DateTime @default(now())
}

model Media {
  id        String   @id @default(uuid())
  type      String   // "photo" or "video"
  title     String
  caption   String?
  date      String
  url       String
  createdAt DateTime @default(now())
}

model OverseasChapter {
  id          String   @id @default(uuid())
  country     String
  flag        String
  city        String
  established String
  coordinator String
  phone       String
  email       String
  members     Int      @default(0)
}

model LeadershipProfile {
  id          String  @id @default(uuid())
  name        String
  role        String
  tier        Int     @default(2)
  city        String
  category    String  @default("cabinet")
  image       String?
  period      String?
  description String?
}

model LeadershipMessage {
  id         String  @id @default(uuid())
  type       String  @unique // "president" or "secretary"
  name       String
  body       String
  photo      String?
  attributes String? // JSON string
}

model SiteSettings {
  id                  String   @id @default("settings")
  whatsappNumber      String
  contactEmail        String
  contactPhone        String
  address             String
  facebookUrl         String
  twitterUrl          String
  instagramUrl        String
  linkedinUrl         String
  heroSlides          Json?    // String[]
  paymentMethods      Json?    // Array of objects
  membershipTiers     Json?    // Array of objects
  matrimonialPackages Json?    // Array of objects
  constitutionPdfUrl  String?
  constitutionPdfName String?
  memorandumPdfUrl    String?
  memorandumPdfName   String?
  rulesPdfUrl         String?
  rulesPdfName        String?
  developerPercentage Int?     @default(20)
}

model RevenueRecord {
  id               String   @id @default(uuid())
  customerName     String
  itemType         String
  itemName         String
  amount           Float
  paymentFrequency String   @default("one_time")
  date             DateTime @default(now())

  @@index([itemType])
  @@index([date])
}
