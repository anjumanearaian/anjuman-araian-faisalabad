generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
}

model Message {
  id        String   @id @default(uuid())
  type      String
  name      String
  email     String
  phone     String?
  message   String
  status    String   @default("unread")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model Member {
  id               String    @id @default(uuid())
  formNo           String?   @unique
  memberNo         String    @unique
  fullName         String
  fatherName       String
  cnic             String
  dob              String
  gender           String
  bloodGroup       String
  email            String
  phone            String
  whatsapp         String
  whatsappPublic   Boolean   @default(false)
  address          String
  localArea        String?
  city             String
  district         String
  province         String
  occupation       String
  education        String
  membershipType   String
  password         String?
  authUserId       String?   @unique
  authUser         AuthUser? @relation(fields: [authUserId], references: [id], onDelete: SetNull)
  designation      String?
  institutionName  String?
  businessName     String?
  memberCell       String    @default("male")
  paymentStatus    String    @default("pending")
  familyInfoPublic Boolean   @default(false)
  status           String    @default("pending")
  visibility       String    @default("private")
  showOnWeb        Boolean   @default(false)
  showOnPortal     Boolean   @default(true)
  photoUrl         String?
  cnicFrontUrl     String?
  cnicBackUrl      String?
  paymentProofUrl  String?
  additionalPhotos String?
  adminNote        String?
  rejectionReason  String?
  isFeatured       Boolean   @default(false)
  isFeaturedPortal Boolean   @default(false)
  referrerMemberId String?
  referrerMember   Member?   @relation("MemberReferrals", fields: [referrerMemberId], references: [id], onDelete: SetNull)
  referrals        Member[]  @relation("MemberReferrals")
  referralStatus   String    @default("not_provided")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  approvedAt       DateTime?

  familyInfo         FamilyInfo?
  children           MemberChild[]
  leadershipProfiles LeadershipProfile[]
  organizationAssignments OrganizationAssignment[]
  meetingAttendance       MeetingAttendance[]
  financeTransactions     FinanceTransaction[]

  @@index([status])
  @@index([membershipType])
  @@index([createdAt])
  @@index([referrerMemberId])
}

model FamilyInfo {
  id                     String  @id @default(uuid())
  memberId               String  @unique
  member                 Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  fatherName             String?
  familyBranch           String?
  caste                  String?
  religiousSect          String?
  spouseName             String?
  childrenCount          String?
  childrenDetails        String?
  familyContactName      String?
  familyContactNumber    String?
  familyCity             String?
  emergencyContactName   String?
  emergencyContactNumber String?
  emergencyRelationship  String?
}

model MemberChild {
  id        String   @id @default(uuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  fullName  String
  dob       String?
  education String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId])
}

model Business {
  id                 String   @id @default(uuid())
  businessName       String
  ownerName          String
  category           String
  city               String
  address            String
  phone              String
  whatsapp           String
  email              String
  website            String
  socialLinks        String
  productsServices   String
  discountOffer      String
  description        String
  sponsorshipPackage String
  logoUrl            String?
  paymentProofUrl    String?
  additionalPhotos   String?
  status             String   @default("pending")
  paymentStatus      String   @default("pending")
  adminNote          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model Matrimonial {
  id                  String    @id @default(uuid())
  name                String
  gender              String
  age                 String
  city                String
  education           String
  profession          String
  familyBackground    String
  requirements        String
  contact             String
  photoUrl            String?
  additionalPhotos    String?
  paymentProofUrl     String?
  status              String    @default("pending")
  paymentStatus       String    @default("pending")
  adminNote           String?
  isFeatured          Boolean   @default(false)
  showOnPortal        Boolean   @default(false)
  authUserId          String?
  authUser            AuthUser? @relation(fields: [authUserId], references: [id], onDelete: SetNull)
  applicantType       String    @default("non_member")
  feeAmount           Int       @default(5000)
  relationToCandidate String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  requestedMatches MatrimonialMatchRequest[] @relation("RequesterProfile")
  receivedMatches  MatrimonialMatchRequest[] @relation("TargetProfile")

  @@index([status])
  @@index([paymentStatus])
  @@index([isFeatured])
  @@index([authUserId])
  @@index([createdAt])
}

model MatrimonialMatchRequest {
  id                  String      @id @default(uuid())
  requesterAuthUserId String
  requesterAuthUser   AuthUser    @relation(fields: [requesterAuthUserId], references: [id], onDelete: Cascade)
  requesterProfileId  String
  requesterProfile    Matrimonial @relation("RequesterProfile", fields: [requesterProfileId], references: [id], onDelete: Cascade)
  targetProfileId     String
  targetProfile       Matrimonial @relation("TargetProfile", fields: [targetProfileId], references: [id], onDelete: Cascade)
  status              String      @default("pending_admin")
  requesterMessage    String?
  adminNote           String?
  adminApprovedAt     DateTime?
  targetRespondedAt   DateTime?
  contactReleasedAt   DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@unique([requesterProfileId, targetProfileId])
  @@index([requesterAuthUserId])
  @@index([targetProfileId])
  @@index([status])
}

model AuthUser {
  id            String                    @id @default(uuid())
  email         String                    @unique
  name          String?
  provider      String                    @default("email")
  verifiedAt    DateTime                  @default(now())
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  member        Member?
  drafts        FormDraft[]
  matrimonial   Matrimonial[]
  matchRequests MatrimonialMatchRequest[]

  @@index([email])
}

model EmailOtp {
  id         String    @id @default(uuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
}

model FormDraft {
  id            String    @id @default(uuid())
  authUserId    String
  authUser      AuthUser  @relation(fields: [authUserId], references: [id], onDelete: Cascade)
  formType      String
  data          Json
  currentStep   Int       @default(0)
  completion    Int       @default(0)
  status        String    @default("incomplete")
  paymentStatus String    @default("pending")
  submittedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([authUserId, formType])
  @@index([formType, status])
  @@index([updatedAt])
}

model StoredFile {
  id           String   @id @default(uuid())
  originalName String
  mimeType     String
  size         Int
  category     String   @default("document")
  data         Bytes
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

model Content {
  id        String   @id @default(uuid())
  type      String
  title     String
  body      String
  date      String
  time      String?
  location  String?
  category  String
  status    String   @default("draft")
  images    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Media {
  id        String   @id @default(uuid())
  type      String
  title     String
  caption   String?
  date      String
  url       String
  createdAt DateTime @default(now())
}

model OverseasChapter {
  id          String @id @default(uuid())
  country     String
  flag        String
  city        String
  established String
  coordinator String
  phone       String
  email       String
  members     Int    @default(0)
}

model LeadershipProfile {
  id          String  @id @default(uuid())
  memberId    String?
  member      Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  name        String
  role        String
  tier        Int     @default(2)
  city        String
  category    String  @default("cabinet")
  image       String?
  period      String?
  description String?

  @@index([memberId])
}

model LeadershipMessage {
  id         String  @id @default(uuid())
  type       String  @unique
  name       String
  body       String
  photo      String?
  attributes String?
}

model SiteSettings {
  id                  String  @id @default("settings")
  whatsappNumber      String
  contactEmail        String
  contactPhone        String
  address             String
  facebookUrl         String
  twitterUrl          String
  instagramUrl        String
  linkedinUrl         String
  heroSlides          Json?
  paymentMethods      Json?
  membershipTiers     Json?
  matrimonialPackages Json?
  constitutionPdfUrl  String?
  constitutionPdfName String?
  memorandumPdfUrl    String?
  memorandumPdfName   String?
  rulesPdfUrl         String?
  rulesPdfName        String?
  developerPercentage Int?    @default(20)
}

model RevenueRecord {
  id               String   @id @default(uuid())
  customerName     String
  itemType         String
  itemName         String
  amount           Float
  paymentFrequency String   @default("one_time")
  reference        String?  @unique
  receiptNo        String?  @unique
  date             DateTime @default(now())

  @@index([itemType])
  @@index([reference])
  @@index([date])
}

// ─────────────────────────────────────────────────────────────────────────────
// Governance & Operations Center
// Additive models only. Existing Member, Content, LeadershipProfile,
// OverseasChapter and RevenueRecord data remains untouched and usable.
// ─────────────────────────────────────────────────────────────────────────────
model OrganizationUnit {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  type        String   @default("committee")
  parentId    String?
  parent      OrganizationUnit?  @relation("OrganizationHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    OrganizationUnit[] @relation("OrganizationHierarchy")
  description String?
  areaName    String?
  displayOrder Int     @default(0)
  isActive    Boolean  @default(true)
  tenureStart String?
  tenureEnd   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments OrganizationAssignment[]
  meetings    GovernanceMeeting[]

  @@index([type])
  @@index([parentId])
  @@index([isActive, displayOrder])
}

model OrganizationAssignment {
  id             String           @id @default(uuid())
  memberId       String
  member         Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  organizationId String
  organization   OrganizationUnit @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           String
  rank           Int              @default(10)
  period         String?
  notes          String?
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([memberId, organizationId, role, period])
  @@index([memberId])
  @@index([organizationId, isActive, rank])
}

model GovernanceMeeting {
  id             String            @id @default(uuid())
  organizationId String?
  organization   OrganizationUnit? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  title          String
  meetingType    String            @default("meeting")
  date           String
  time           String?
  venue          String?
  status         String            @default("announced")
  notice         String?
  agenda         String?
  minutes        String?
  images         String?
  published      Boolean           @default(false)
  contentId       String?           @unique
  createdByAdminId String?
  createdByName  String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  attendance MeetingAttendance[]

  @@index([date])
  @@index([status])
  @@index([organizationId])
}

model MeetingAttendance {
  id        String            @id @default(uuid())
  meetingId String
  meeting   GovernanceMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status    String            @default("present")
  remarks   String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([meetingId, memberId])
  @@index([meetingId])
  @@index([memberId])
}

model FinanceTransaction {
  id                String   @id @default(uuid())
  serialNo          Int      @unique @default(autoincrement())
  transactionNo     String   @unique
  type              String
  direction         String   @default("credit")
  memberId          String?
  member            Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  partyName         String
  category          String
  amount            Float
  paymentMethod     String?
  cashBookNo        String?
  receiptNo         String?  @unique
  voucherNo         String?  @unique
  externalReference String?
  description       String?
  issuedByAdminId   String?
  issuedByName      String?
  issuedByRole      String?
  handledByMemberId String?
  handledByName     String?
  handledByRole     String?
  status            String   @default("posted")
  transactionDate   DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  auditLogs FinanceAuditLog[]

  @@index([type, direction])
  @@index([memberId])
  @@index([transactionDate])
  @@index([cashBookNo])
  @@index([status])
}

model FinanceHead {
  id            String   @id @default(uuid())
  name          String
  kind          String   @default("revenue")
  defaultAmount Float?
  notes         String?
  displayOrder  Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([name, kind])
  @@index([kind, isActive, displayOrder])
}

model FinanceAuditLog {
  id            String              @id @default(uuid())
  transactionId String?
  transaction   FinanceTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  action        String
  actorAdminId  String?
  actorName     String?
  beforeData    Json?
  afterData     Json?
  createdAt     DateTime            @default(now())

  @@index([transactionId])
  @@index([createdAt])
}
